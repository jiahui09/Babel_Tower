pkgname=babel-tower-phase3-txt
pkgver=0.1.0
pkgrel=1
pkgdesc='Babel Tower Phase 3 offline TXT vertical slice'
arch=('x86_64')
license=('AGPL3')
depends=('glibc' 'gcc-libs')
source=('babel-phase3' 'babel-txt-worker')
sha256sums=(
  "${BABEL_PHASE3_SHA256:?set BABEL_PHASE3_SHA256 before makepkg}"
  "${BABEL_TXT_WORKER_SHA256:?set BABEL_TXT_WORKER_SHA256 before makepkg}"
)

package() {
  install -Dm755 "$srcdir/babel-phase3" "$pkgdir/usr/lib/babel-tower-phase3/babel-phase3"
  install -Dm755 "$srcdir/babel-txt-worker" "$pkgdir/usr/lib/babel-tower-phase3/babel-txt-worker"
  install -Dm644 /dev/stdin "$pkgdir/usr/share/licenses/$pkgname/LICENSE" <<'EOF'
AGPL-3.0-or-later: Phase 3 TXT slice source is distributed with Babel Tower.
EOF
  install -Dm644 /dev/stdin "$pkgdir/usr/share/babel-tower-phase3/sbom.spdx.json" <<'EOF'
{"spdxVersion":"SPDX-2.3","SPDXID":"SPDXRef-DOCUMENT","name":"babel-tower-phase3-txt","packages":[{"SPDXID":"SPDXRef-Package","name":"babel-phase3","versionInfo":"0.1.0","licenseConcluded":"AGPL-3.0-or-later"},{"SPDXID":"SPDXRef-TxtWorker","name":"babel-txt-worker","versionInfo":"0.1.0","licenseConcluded":"AGPL-3.0-or-later"}]}
EOF
}
